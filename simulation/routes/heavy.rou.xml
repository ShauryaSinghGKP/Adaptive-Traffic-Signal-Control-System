    <flow id="north_cars" type="car" route="north_south" begin="0" end="400" period="1.5" />
    <flow id="east_cars" type="car" route="east_west" begin="0" end="400" period="1.5" />
    <flow id="west_cars" type="car" route="west_east" begin="0" end="400" period="1.5" />
    <flow id="north_trucks" type="truck" route="north_south" begin="1" end="400" period="12" />
    <flow id="south_cars" type="car" route="south_north" begin="1" end="400" period="1.5" />
