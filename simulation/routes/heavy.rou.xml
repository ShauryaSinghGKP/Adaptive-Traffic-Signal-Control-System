<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <vType id="car" vClass="passenger" length="5" accel="2.6" decel="4.5" maxSpeed="13.89" />
    <vType id="truck" vClass="truck" length="9" accel="1.3" decel="4.0" maxSpeed="11.11" />
    <vType id="motorcycle" vClass="motorcycle" length="2.2" accel="3.0" decel="5.0" maxSpeed="13.89" />
    <route id="north_south" edges="north_in south_out" />
